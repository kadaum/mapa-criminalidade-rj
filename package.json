{
  "name": "mapa-criminalidade-rj",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node --experimental-strip-types scripts/build-neighborhood-labels.mjs",
    "dev": "vinext dev",
    "prebuild": "node --experimental-strip-types scripts/build-neighborhood-labels.mjs",
    "build": "vinext build",
    "build:icons": "node scripts/build-icons.mjs",
    "build:share-cards": "node scripts/build-share-cards.mjs",
    "data:setup": "node scripts/setup-local-data.mjs",
    "prepare:public-data": "node scripts/setup-local-data.mjs && node scripts/sync-neighborhood-context.mjs && npm run build:share-cards && node --experimental-strip-types scripts/build-neighborhood-labels.mjs",
    "test": "node scripts/eval-product.mjs --unit && node --experimental-strip-types --test scripts/*.test.mjs scripts/*.test.ts",
    "test:integration": "node scripts/eval-product.mjs",
    "typecheck": "tsc --noEmit",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "sync:data": "node scripts/sync-data.mjs && node scripts/sync-history.mjs && node --experimental-strip-types scripts/build-neighborhood-labels.mjs",
    "sync:history": "node scripts/sync-history.mjs",
    "test:history": "node --test scripts/history.test.mjs",
    "test:region-filters": "node --experimental-strip-types --test scripts/region-filter-state.test.ts",
    "test:contributions": "node --experimental-strip-types --test scripts/contributions.test.ts",
    "db:generate": "drizzle-kit generate",
    "check:population-source": "node scripts/check-population-source.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "lint": "oxlint app components/*.tsx lib scripts/setup-local-data.mjs scripts/sync-data.mjs scripts/sync-history.mjs scripts/sync-neighborhood-context.mjs scripts/build-icons.mjs scripts/build-share-cards.mjs scripts/validate-data.mjs scripts/validate-cameras.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "maplibre-gl": "^6.7.0",
    "motion": "^13.2.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260905.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "undici": "7.29.1",
    "esbuild": "0.28.1",
    "sharp": "0.35.5",
    "tinypool": "2.1.2"
  },
  "type": "module"
}
